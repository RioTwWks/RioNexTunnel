{
  "manifest_version": 3,
  "name": "RioNexTunnel Proxy Auth",
  "version": "1.0.0",
  "description": "Auto-fills local proxy authentication for RioNexTunnel sessions.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RioNexTunnel Proxy Auth"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "secure-vpn-proxy-auth@secure-vpn.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
